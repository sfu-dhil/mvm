{% extends 'base.html.twig' %}

{% block title %}Region List{% endblock %}

{% block breadcrumb %}
    {% include 'partial/breadcrumb.html.twig' with {'index': 'region'} %}
{% endblock %}

{% block pageheader %}
    <h1>Regions</h1>
    <p>Geographical areas with which at least one manuscript is associated</p>
    <div class="afs-filter-counter"></div>
{% endblock %}

{% block action_buttons %}
    {% include 'partial/toolbar.html.twig' with {'new': 'region_new'} %}
{% endblock %}

{% block body %}
    <div class="input-group">
        <input type="search" id="search" name="search" class="form-control filter-search mb-5" placeholder="Search by name of towns or counties within England and Ireland, Scottish towns, American towns or states, or other countries" />
        <span class="input-group-btn">
            <button id="filter-reset" class="btn btn-light" type="submit">
                <i class="bi bi-arrow-clockwise"></i>
                Reset
            </button>
        </span>
    </div>
    {% include 'region/partial/index.html.twig' %}
    <div class="navigation">
        <nav>
            <div class="afs-pagination-container pagination justify-content-end"></div>
        </nav>
    </div>
{% endblock %}


{% block javascripts %}
    <script>
        $(function () {
            const afs = new window.AFS.AFS({
                containerSelector: '.table-gallery',
                itemSelector: '.table-item',
                searchInputSelector: '#search',
                searchKeys: ['name'],
                minSearchLength: 1,
                pagination: {
                    enabled: true,
                    itemsPerPage: 25,
                    maxButtons: 6,
                    container: '.afs-pagination-container',
                    containerClass: 'justify-content-end gap-0',
                    pageButtonClass: 'page-link',
                    activePageClass: 'active',
                    showPrevNext: true,
                    scrollToTop: true,
                },
                counterSelector: '.afs-filter-counter',
                counter: {
                    template: 'Displaying {visible} regions',
                    showFiltered: true,
                    noResultsTemplate: 'No results found',
                },
                animation: { type: 'fade', duration: 0 },
            })

            const resetFilterBtn = document.getElementById('filter-reset')
            resetFilterBtn.addEventListener("click", () => {
                afs.search.clearSearch('')
                afs.pagination.firstPage()
            })

            const queryParams = new URLSearchParams(window.location.search);
            if (queryParams.has("search")) {
                document.getElementById("search").value = queryParams.get("search")
                afs.search.search(queryParams.get("search"))
            }
        })
    </script>
{% endblock %}