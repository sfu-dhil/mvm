{% extends 'base.html.twig' %}

{% block title %}Feature List{% endblock %}

{% block breadcrumb %}
    {% include 'partial/breadcrumb.html.twig' with {'index': 'feature'} %}
{% endblock %}

{% block pageheader %}
    <h1>Features</h1>
    <p>Bibliographical, decorative, organizational, or user-related features of a manuscript</p>
    <p class="count">Displaying {{ features|length }} features</p>
{% endblock %}


{% block action_buttons %}
    {% include 'partial/toolbar.html.twig' with {'new': 'feature_new'} %}
{% endblock %}

{% block body %}

    <table class="table">
        <thead>
            <tr>
                <th>Feature</th>
                <th>Description</th>
                <th>Manuscripts</th>
            </tr>
        </thead>
        <tbody>
            {% for feature in features %}
                <tr>
                    <td>
                        <a href="{{ path('feature_show',{'id': feature.id}) }}">
                            {{ feature }}
                        </a>
                    </td>
                    <td>{{ feature.description|replace({'https://mvm.dhil.lib.sfu.ca/': '../', 'https://dhil.lib.sfu.ca/mvm/': '../'})|raw }}</td>
                    <td class="number">{{ feature.manuscriptFeatures|length }}</td>
                </tr>

            {% endfor %}
        </tbody>
    </table>
{% endblock %}
