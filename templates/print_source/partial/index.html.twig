{% if printSources|length > 0 %}
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Regions</th>
                <th>Description</th>
                <th>Manuscripts</th>
            </tr>
        </thead>
        <tbody class="table-gallery">
            {% for source in printSources %}
                <tr class="table-item"
                    data-name="{{ source.name|striptags|e('html_attr') }}"
                    data-description="{{ source.description|replace({'https://mvm.dhil.lib.sfu.ca/': '../', 'https://dhil.lib.sfu.ca/mvm/': '../'})|striptags|e('html_attr') }}"
                    data-regions="{{ source.regions|join(' | ')|striptags|e('html_attr') }}"
                >
                    <td><a href="{{ path('print_source_show',{'id': source.id}) }}">{{ source.label }}</a></td>
                    <td>
                        {% if source.regions|length > 0 %}
                            <ul>
                                {% for region in source.regions %}
                                    <li>
                                        <a href="{{ path('region_show', {'id': region.id}) }}">{{ region }}</a>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </td>
                    <td>
                        {{ source.description|replace({'https://mvm.dhil.lib.sfu.ca/': '../', 'https://dhil.lib.sfu.ca/mvm/': '../'})|raw }}
                    </td>
                    <td class="number">
                        {{ source.manuscripts|length }}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}
